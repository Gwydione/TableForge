<Window x:Class="TableForge.DddiceAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dddice account" Width="460" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Connect / choose a theme / disconnect. There is no password field anywhere: the person approves TableForge on
         dddice.com in their own browser, with the code shown here. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="AccountStateText" Text="{Binding AccountText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />

        <!-- Not connected, or the connection expired. -->
        <StackPanel Visibility="{Binding ShowConnect, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                       Text="Connect your dddice account to roll with a theme from your Digital Dice Box. You approve the connection on dddice.com; TableForge never asks for your dddice password." />
            <Button x:Name="ConnectButton" Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" HorizontalAlignment="Left" Padding="14,4" />
        </StackPanel>

        <!-- An activation under way: the code, a way to reach dddice.com, and Cancel. -->
        <StackPanel x:Name="ActivationPanel" Visibility="{Binding ShowActivation, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <TextBlock Text="Connect dddice account" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Code: " VerticalAlignment="Center" FontSize="16" />
                <TextBlock x:Name="ActivationCodeText" Text="{Binding ActivationCode}" VerticalAlignment="Center" FontSize="22"
                           FontFamily="Consolas" FontWeight="Bold" Margin="4,0,12,0" />
                <Button x:Name="CopyCodeButton" Content="Copy" Command="{Binding CopyCodeCommand}" Padding="10,2" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                       Text="Open dddice.com/activate, sign in there if asked, and enter this code." />
            <Button x:Name="OpenDddiceButton" Content="Open dddice" Command="{Binding OpenDddiceCommand}" HorizontalAlignment="Left" Padding="14,4" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Waiting for approval…" Foreground="#555" VerticalAlignment="Center" />
                <Button x:Name="CancelActivationButton" Content="Cancel" Command="{Binding CancelCommand}" Padding="10,2" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Connected: every theme in the Digital Dice Box; the ones TableForge cannot use are listed, disabled, with the reason. -->
        <StackPanel x:Name="ThemePanel" Visibility="{Binding ShowThemes, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="RefreshThemesButton" DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,2" />
                <TextBlock Text="Theme" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Loading your Dice Box…" Foreground="#555" Visibility="{Binding IsLoadingThemes, Converter={StaticResource BoolToVis}}" />
            <ListBox x:Name="ThemeList" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" MaxHeight="300"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,2">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#777" TextWrapping="Wrap"
                                       Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <TextBlock x:Name="AccountMessageText" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#7A5200" Margin="0,0,0,8"
                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />

        <DockPanel Margin="0,4,0,0">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Padding="14,4" IsCancel="True" Click="OnClose" />
            <Button x:Name="DisconnectButton" Content="Disconnect" Command="{Binding DisconnectCommand}" HorizontalAlignment="Left" Padding="10,4"
                    ToolTip="Forget the dddice connection on this computer. Your dddice account is not changed."
                    Visibility="{Binding ShowDisconnect, Converter={StaticResource BoolToVis}}" />
        </DockPanel>
    </StackPanel>
</Window>
