<Window x:Class="TableForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TableForge.ViewModels"
        xmlns:views="clr-namespace:TableForge.Views"
        xmlns:app="clr-namespace:TableForge"
        Title="Gidubba — RPG Rollable Tables" Icon="Assets/Gidubba.ico"
        Width="1200" Height="820" MinWidth="1000" MinHeight="640"
        FontSize="14">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- A flat, list-like button for the Recent Rolls rows. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6EDF7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6EDF7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A table's name (trimmed if long) with its dice on the right, and its folder below when the view calls for it
             (searching, or All Tables): redundant and hidden while a specific folder or Unfiled is already the whole view. -->
        <DataTemplate x:Key="TableRow">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Dice}" Foreground="#777" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding FolderName}" FontSize="11" Foreground="#999" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DataContext.ShowFolderInList, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PasteViewModel}"><views:PasteView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReviewViewModel}"><views:ReviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RollViewModel}"><views:RollView /></DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Background="#F6F6F6" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Foreground="#444" MinHeight="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                <!-- The OBS result overlay: its settings, Show Test Result and Clear Overlay. -->
                <Button x:Name="StreamingOverlayButton" Grid.Column="1" Content="Streaming Overlay…" Padding="8,0" Margin="12,0,0,0"
                        Command="{Binding StreamingOverlayCommand}" ToolTip="Show Gidubba results in OBS"
                        Visibility="{Binding HasStreamingOverlay, Converter={StaticResource BoolToVis}}" />
                <!-- Where the tables and settings live (to back them up by copying the folder while TableForge is closed). -->
                <Button x:Name="OpenDataFolderButton" Grid.Column="2" Content="Open Data Folder" Padding="8,0" Margin="6,0,0,0"
                        Command="{Binding OpenDataFolderCommand}" ToolTip="{Binding DataFolder}"
                        Visibility="{Binding HasDataFolder, Converter={StaticResource BoolToVis}}" />
                <Button x:Name="AboutButton" Grid.Column="3" Content="About" Padding="8,0" Margin="6,0,0,0"
                        Command="{Binding AboutCommand}" ToolTip="About Gidubba"
                        Visibility="{Binding HasAbout, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="4" x:Name="VersionText" Text="{x:Static app:AppInfo.VersionAndBuild}" Foreground="#888" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The whole left pane scrolls if the window is short, so nothing in it is ever out of reach. -->
            <ScrollViewer Grid.Column="0" x:Name="LeftScroll" Margin="12,12,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="OnLeftPaneSizeChanged">
                <StackPanel x:Name="LeftContent" Margin="0,0,12,0" SizeChanged="OnLeftPaneSizeChanged">
                    <TextBlock Text="Collection" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="CollectionBox" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}"
                              DisplayMemberPath="Name" Margin="0,0,0,6" />
                    <!-- Acting on the selected collection: save it as a .tfcollection file, or delete it with everything in it. -->
                    <UniformGrid x:Name="CollectionActions" Rows="1" Columns="2" Margin="0,0,0,6">
                        <Button x:Name="ExportCollectionButton" Content="Export Collection…" Margin="0,0,3,0" Padding="4,2"
                                Command="{Binding ExportCollectionCommand}"
                                ToolTip="Save the selected collection as a file another copy of Gidubba can import" />
                        <Button x:Name="DeleteCollectionButton" Content="Delete Collection…" Margin="3,0,0,0" Padding="4,2"
                                Command="{Binding DeleteCollectionCommand}"
                                ToolTip="Delete the selected collection and every table in it" />
                    </UniformGrid>
                    <!-- The selected collection as a .pumb bundle for PUM Companion, after a review. -->
                    <Button x:Name="ExportPumButton" Content="Export to PUM Companion…" Padding="4,2" Margin="0,0,0,6"
                            Command="{Binding ExportPumCommand}"
                            ToolTip="Save the selected collection as a .pumb file to import into PUM Companion" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewCollectionBox" Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Name for a new collection (press Enter to create it)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CreateCollectionCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="New collection" Margin="6,0,0,0" Padding="8,2"
                                Command="{Binding CreateCollectionCommand}" />
                    </Grid>
                    <!-- The other way to get a new collection: from a .tfcollection file. Existing collections are never changed. -->
                    <Button x:Name="ImportCollectionButton" Content="Import Collection…" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,16"
                            Command="{Binding ImportCollectionCommand}"
                            ToolTip="Add a collection from a .tfcollection file (existing collections are not changed)" />

                    <Button x:Name="PasteTableButton" Content="Paste Table…" Padding="8,6" Margin="0,0,0,16"
                            Command="{Binding PasteTableCommand}" />

                    <!-- Which dice roll the tables. Built-in is the default and needs nothing; dddice shows real 3D dice and needs the internet.
                         Kept above the folder and table lists, which grow with the collection, so it is always in view without scrolling. -->
                    <StackPanel x:Name="DiceChoice" Margin="0,0,0,16" DataContext="{Binding DiceProviders}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Dice" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <RadioButton x:Name="BuiltInRadio" GroupName="DiceProvider" Content="Built-in" Margin="0,2,0,0"
                                     AutomationProperties.AutomationId="DiceProviderBuiltIn"
                                     IsChecked="{Binding IsBuiltInSelected, Mode=TwoWay}" />
                        <RadioButton x:Name="DddiceRadio" GroupName="DiceProvider" Content="dddice (3D dice, needs internet)" Margin="0,2,0,0"
                                     AutomationProperties.AutomationId="DiceProviderDddice"
                                     IsEnabled="{Binding IsDddiceAvailable}"
                                     IsChecked="{Binding IsDddiceSelected, Mode=TwoWay}" />
                        <!-- Who dddice rolls as (Guest, or the connected account and its theme). The account itself is managed in Account…,
                             so this stays two short lines and one button. -->
                        <Grid x:Name="DddiceIdentity" Margin="20,4,0,0" Visibility="{Binding ShowDddiceIdentity, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DddiceIdentityText" Text="{Binding DddiceIdentityText}" Foreground="#555" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DddiceThemeText" Text="{Binding ThemeText}" Foreground="#555" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasThemeText, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <Button x:Name="DddiceAccountButton" Grid.Column="1" Content="Account…" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="DddiceAccount" Command="{Binding AccountCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- Folder navigation: All Tables / Unfiled always present, then this collection's folders (alphabetical, flat — no nesting). -->
                    <TextBlock Text="Folders" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ListBox x:Name="FolderNavList" ItemsSource="{Binding FolderNav}" SelectedItem="{Binding SelectedFolderNav}"
                             DisplayMemberPath="Name" MaxHeight="140" Margin="0,0,0,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewFolderBox" Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Name for a new folder in this collection (press Enter to create it)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding NewFolderCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="New folder" Margin="6,0,0,0" Padding="8,2" Command="{Binding NewFolderCommand}" />
                    </Grid>
                    <Grid Margin="0,0,0,16" Visibility="{Binding IsRealFolderSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RenameFolderBox" Text="{Binding RenameFolderName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Rename the selected folder (press Enter to apply)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding RenameFolderCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Rename" Margin="6,0,0,0" Padding="8,2" Command="{Binding RenameFolderCommand}" />
                        <Button Grid.Column="2" Content="Delete" Margin="6,0,0,0" Padding="8,2" Command="{Binding DeleteFolderCommand}" />
                    </Grid>

                    <TextBlock Text="Tables" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="TableFilterBox" Margin="0,0,0,6" ToolTip="Filter tables by name. Enter opens the first match; Escape clears."
                             Text="{Binding TableFilter, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding OpenFirstMatchCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding ClearFilterCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- What the list below holds: "All tables", "<folder> tables" or "Search results". (Recent tables are still
                         tracked, but no longer listed here.) -->
                    <TextBlock x:Name="TableListHeading" Text="{Binding TableListHeading}" Foreground="#555" Margin="0,0,0,2" />

                    <!-- Tall enough to fill the pane down to Edit/Delete, never less than 160 px (see FitTableList).
                         Arrow keys only move the highlight; Enter or a click opens the table (so browsing never opens or "uses" tables). -->
                    <ListBox x:Name="TablesList" ItemsSource="{Binding Tables}" SelectedItem="{Binding HighlightedTable}"
                             MinHeight="90" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemTemplate="{StaticResource TableRow}">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding OpenTableCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="TableItem_MouseUp" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Grid x:Name="TableActions" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Edit table" Padding="8,4" Margin="0,0,3,0" Command="{Binding EditTableCommand}" />
                        <Button Grid.Column="1" Content="Delete table" Padding="8,4" Margin="3,0,0,0" Command="{Binding DeleteTableCommand}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1,0,0,0">
              <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- dddice's dice tumble here (a WebView2 is placed in DiceHost). Only shown while dddice is chosen.
                     The message strip sits BELOW the dice, not over them: a WebView draws in its own window and would hide anything on top. -->
                <Border x:Name="DicePanel" Grid.Row="0" Background="#FF243B2C" DataContext="{Binding DiceProviders}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowDicePanel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border x:Name="DiceHost" Height="190" />
                        <Grid Background="#FF17281D" MinHeight="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DiceStatusText" Text="{Binding Message}" AutomationProperties.AutomationId="DiceStatus"
                                       Foreground="#FFE8F5EA" Margin="12,7" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,8,4">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowFailure}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button x:Name="UseBuiltInButton" Content="Use Built-in Dice" Padding="10,3" Margin="0,0,6,0"
                                        AutomationProperties.AutomationId="UseBuiltInDice" Command="{Binding UseBuiltInCommand}" />
                                <Button x:Name="DiceAccountFailureButton" Content="Account…" Padding="10,3" Margin="0,0,6,0"
                                        AutomationProperties.AutomationId="DiceAccountOnFailure" Command="{Binding AccountCommand}"
                                        Visibility="{Binding ShowAccountOnFailure, Converter={StaticResource BoolToVis}}" />
                                <Button x:Name="DiceRetryButton" Content="Try again" Padding="10,3"
                                        AutomationProperties.AutomationId="DiceRetry" Command="{Binding RetryCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- The current screen, with the Recent Rolls panel at its foot. The panel's list never takes more than 40% of
                     this area (see OnMainAreaSizeChanged), so the Roll screen above stays usable, dddice panel and all. -->
                <Grid x:Name="MainArea" Grid.Row="1" SizeChanged="OnMainAreaSizeChanged">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <ContentControl Content="{Binding Current}" IsTabStop="False" />
                    <TextBlock x:Name="EmptyStateBlock" Text="{Binding EmptyStateText}" Foreground="#777" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="440" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                  </Grid>

                  <!-- Recent rolls: the last 10 rolls anywhere, newest first. Closed at start; open or closed stays as left for the
                       session, across tables and while hidden for editing. Hover for the full snapshot; clicking reopens the table. -->
                  <Expander x:Name="RecentRollsPanel" Grid.Row="1" IsExpanded="{Binding IsRecentRollsExpanded}" Padding="16,0,16,6"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0"
                            Visibility="{Binding ShowRecentRolls, Converter={StaticResource BoolToVis}}">
                      <Expander.Header>
                          <TextBlock x:Name="RecentRollsHeader" Text="{Binding RecentRollsHeading}" FontWeight="SemiBold" Margin="4,4,0,4" />
                      </Expander.Header>
                      <ScrollViewer x:Name="RecentRollsScroller" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl x:Name="RecentRollsList" ItemsSource="{Binding RecentRolls}" Focusable="False">
                              <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                      <Button Style="{StaticResource RowButton}" ToolTip="{Binding FullText}"
                                              Command="{Binding DataContext.OpenRecentRollCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}">
                                          <StackPanel>
                                              <Grid>
                                                  <Grid.ColumnDefinitions>
                                                      <ColumnDefinition Width="*" />
                                                      <ColumnDefinition Width="Auto" />
                                                  </Grid.ColumnDefinitions>
                                                  <TextBlock Text="{Binding TableName}" TextTrimming="CharacterEllipsis">
                                                      <TextBlock.Style>
                                                          <Style TargetType="TextBlock">
                                                              <Style.Triggers>
                                                                  <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                      <Setter Property="Foreground" Value="#888" />
                                                                      <Setter Property="FontStyle" Value="Italic" />
                                                                  </DataTrigger>
                                                              </Style.Triggers>
                                                          </Style>
                                                      </TextBlock.Style>
                                                  </TextBlock>
                                                  <TextBlock Grid.Column="1" Text="{Binding RollDisplay}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                              </Grid>
                                              <!-- Time, any "Rerolled N×", then the whole result: wrapped, never cut short. -->
                                              <TextBlock x:Name="RecentRollDetail" Text="{Binding Detail}" FontSize="12" Foreground="#666" TextWrapping="Wrap" />
                                          </StackPanel>
                                      </Button>
                                  </DataTemplate>
                              </ItemsControl.ItemTemplate>
                          </ItemsControl>
                      </ScrollViewer>
                  </Expander>
                </Grid>
              </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
