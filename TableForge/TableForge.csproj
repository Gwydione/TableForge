<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- V1 Release Candidate 1. Version drives the file version, the product version and the number shown in the app. -->
    <Version>1.0.0-rc1</Version>
    <Product>TableForge</Product>
    <Description>TableForge - RPG Rollable Tables</Description>
    <AssemblyName>TableForge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
