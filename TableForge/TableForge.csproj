<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Gidubba 1.3.0: auto-follow linked tables and native PUM nested tables. Version drives the file version, the product version and the number shown in the app. -->
    <Version>1.3.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The public name. Product and AssemblyTitle are what Windows shows (file properties, Task Manager); the exe stays
         TableForge.exe, so existing installs, shortcuts and pins keep working. -->
    <Product>Gidubba</Product>
    <AssemblyTitle>Gidubba</AssemblyTitle>
    <Company>RPG Frequencies</Company>
    <Authors>RPG Frequencies</Authors>
    <Copyright>Copyright (c) 2026 RPG Frequencies</Copyright>
    <Description>Gidubba - RPG Rollable Tables</Description>
    <AssemblyName>TableForge</AssemblyName>
    <!-- A byte-for-byte copy of the approved icon, branding\gidubba_concept.ico; it is never regenerated or edited. -->
    <ApplicationIcon>Assets\Gidubba.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Used directly by DatabaseMigrations.ExecuteScript (sqlite3_prepare_v2). The version Microsoft.Data.Sqlite 10.0.12 already resolves. -->
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page that hosts dddice-js inside the WebView2. Loaded from disk through a virtual host name, so it is a real https origin. -->
    <Content Include="Assets\dddice-host.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- The window icon (the same file the exe carries). -->
    <Resource Include="Assets\Gidubba.ico" />
    <!-- Shipped beside the exe (and so in the installer and the zip); About opens them. -->
    <Content Include="..\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\PRIVACY.txt" Link="PRIVACY.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
