<Window x:Class="TableForge.ClipboardDiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TableForge — clipboard diagnostic (developer)" Width="900" Height="640" MinWidth="600" MinHeight="400" FontSize="13">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RefreshButton" Content="Refresh from clipboard" Padding="14,5" Click="OnRefresh" />
            <Button x:Name="CopyButton" Content="Copy this report" Padding="14,5" Margin="8,0,0,0" Click="OnCopy" />
            <TextBlock Foreground="#777" VerticalAlignment="Center" Margin="16,0,0,0"
                       Text="Copy some text in another program, then choose Refresh. Reading the clipboard changes nothing." />
        </StackPanel>
        <TextBox x:Name="ReportBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
