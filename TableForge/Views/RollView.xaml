<UserControl x:Class="TableForge.Views.RollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MatchBrush" Color="#DFF1E1" />
        <SolidColorBrush x:Key="ProblemText" Color="#A00000" />
        <SolidColorBrush x:Key="WarningText" Color="#7A5200" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer x:Name="TrailScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="TrailContent" Margin="16">

            <!-- The trail: every table rolled so far in this linked sequence, oldest first. -->
            <ItemsControl x:Name="StepsList" ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="↓" FontSize="22" Foreground="#888" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DiceInfo}" Foreground="#666" Margin="0,2,0,8" />
                            <TextBlock Text="Not rolled yet." Foreground="#888" FontStyle="Italic" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOutcomes}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Each roll is shown once, followed by the output of every result set. -->
                            <ItemsControl ItemsSource="{Binding Outcomes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Display}" FontSize="16" Foreground="#555" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Foreground="#555"
                                                                       Visibility="{Binding HasHeading, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding Text}" FontSize="26" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource ProblemText}" />
                                                                                <Setter Property="FontSize" Value="18" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Dice expressions found inside the text above, offered as separate, user-triggered rolls.
                                                                 Auxiliary only: rolling one never changes the text itself. -->
                                                            <ItemsControl ItemsSource="{Binding InlineActions}" Margin="0,4,0,0"
                                                                          Visibility="{Binding ShowInlineActions, Converter={StaticResource BoolToVis}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                            <TextBlock FontFamily="Consolas" Foreground="#555" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                                       Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                                                                                <Run Text="{Binding DisplayExpression, Mode=OneWay}" FontWeight="SemiBold" />
                                                                                <Run Text=" → " />
                                                                                <Run Text="{Binding ResultsText, Mode=OneWay}" />
                                                                            </TextBlock>
                                                                            <Button Content="{Binding RollLabel}" Command="{Binding RollCommand}"
                                                                                    Padding="10,3" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- A link is only ever followed by the user, and never rolls the destination. -->
                                                            <Button Content="{Binding FollowLabel}" Command="{Binding FollowCommand}"
                                                                    HorizontalAlignment="Left" Padding="14,5" Margin="0,4,0,0"
                                                                    Visibility="{Binding ShowFollow, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding LinkedNote}" Foreground="#777" Margin="0,2,0,0"
                                                                       Visibility="{Binding ShowLinkedNote, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding UnresolvedNote}" Foreground="{StaticResource WarningText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding ShowUnresolved, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="⚠ The linked table no longer exists." Foreground="{StaticResource WarningText}" Margin="0,4,0,0"
                                                                       Visibility="{Binding ShowMissing, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Rolling always applies to the current (last) table in the trail. -->
            <StackPanel x:Name="RollControls" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RollButton" Content="Roll" FontSize="18" Padding="32,8" Command="{Binding RollCommand}" />
                <!-- Shown only while a visual (dddice) roll is in the air; the table result appears when the dice settle. -->
                <TextBlock x:Name="RollStatusText" Text="{Binding RollStatus}" AutomationProperties.AutomationId="RollStatus"
                           FontSize="16" Foreground="#555" VerticalAlignment="Center" Margin="14,0,0,0" />
                <TextBlock Text="or enter a roll:" Foreground="#666" VerticalAlignment="Center" Margin="24,0,8,0" />
                <TextBox x:Name="ManualBox" Width="70" Padding="4" VerticalContentAlignment="Center"
                         Text="{Binding ManualRollText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ResolveManualCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Resolve" Padding="14,6" Margin="8,0,0,0" Command="{Binding ResolveManualCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource ProblemText}" Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding Title, StringFormat=Table: {0}}" FontWeight="SemiBold" Foreground="#555" Margin="0,24,0,6" />

            <!-- Result sets that are genuine parallel outputs of one roll (same row count, same range at every row):
                 shown as one aligned multi-column grid instead of separate stacked sections, mirroring the Review
                 screen (see RollStepViewModel.IsAligned). Each column is still its own independent result set
                 underneath — only the presentation is grouped. -->
            <Grid Margin="0,0,0,2" Visibility="{Binding IsAligned, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="AlignedRollHeaders" Grid.Column="1" ItemsSource="{Binding ResultSets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="230" Margin="4,0,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <ItemsControl x:Name="AlignedRollRowsList" ItemsSource="{Binding AlignedRows}"
                          Visibility="{Binding IsAligned, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4,2" CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource MatchBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RangeLabel}" FontFamily="Consolas" Foreground="#555" Width="90" />
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Width="230" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Single result set, or several independent sets that are not parallel outputs (e.g. Ambient/Noise):
                 shown one at a time, stacked, as before. -->
            <ItemsControl x:Name="ResultSetsList" ItemsSource="{Binding ResultSets}"
                          Visibility="{Binding IsNotAligned, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,2"
                                       Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,2" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource MatchBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RangeLabel}" FontFamily="Consolas" Foreground="#555" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
