<UserControl x:Class="TableForge.Views.RollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TableForge.Views">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MatchBrush" Color="#DFF1E1" />
        <SolidColorBrush x:Key="ProblemText" Color="#A00000" />
        <SolidColorBrush x:Key="WarningText" Color="#7A5200" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer x:Name="TrailScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="TrailContent" Margin="16">

            <!-- The trail: every table rolled so far in this linked sequence, oldest first. -->
            <ItemsControl x:Name="StepsList" ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="↓" FontSize="22" Foreground="#888" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DiceInfo}" Foreground="#666" Margin="0,2,0,8" />
                            <TextBlock Text="Not rolled yet." Foreground="#888" FontStyle="Italic" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOutcomes}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Each roll is shown once, followed by the output of every result set. -->
                            <ItemsControl ItemsSource="{Binding Outcomes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <!-- "Roll 2": only for the results of one Roll action that made several rolls, each kept separate. -->
                                            <TextBlock x:Name="BatchLabelText" Text="{Binding BatchLabel}" FontWeight="SemiBold" Foreground="#333" Margin="0,4,0,2"
                                                       Visibility="{Binding HasBatchLabel, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Display}" FontSize="16" Foreground="#555" Margin="0,0,0,4" />
                                            <!-- Only for a roll that used a situational modifier: how the final number was reached. -->
                                            <TextBlock Text="{Binding Breakdown}" Foreground="#555" Margin="0,-2,0,4"
                                                       Visibility="{Binding HasBreakdown, Converter={StaticResource BoolToVis}}" />
                                            <!-- Only for a roll the table's Clamp to Range looked up at a boundary: the number above stays
                                                 what was calculated; this is the value the table was resolved with. -->
                                            <TextBlock x:Name="ClampNoteText" Text="{Binding ClampNote}" Foreground="#555" FontWeight="SemiBold" Margin="0,-2,0,4"
                                                       Visibility="{Binding HasClampNote, Converter={StaticResource BoolToVis}}" />
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Foreground="#555"
                                                                       Visibility="{Binding HasHeading, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock views:FormattedText.Segments="{Binding Segments}" FontSize="26" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource ProblemText}" />
                                                                                <Setter Property="FontSize" Value="18" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- The text above with each rolled inline expression replaced in place by its latest value
                                                                 ("You gain +3 Armor"). A transient, subordinate copy: the text above never changes. -->
                                                            <TextBlock x:Name="ResolvedInlineText" views:FormattedText.Segments="{Binding ResolvedSegments}"
                                                                       FontSize="18" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                       Visibility="{Binding ShowResolved, Converter={StaticResource BoolToVis}}" />
                                                            <!-- Dice expressions found inside the text above, offered as separate, user-triggered rolls. -->
                                                            <ItemsControl ItemsSource="{Binding InlineActions}" Margin="0,4,0,0"
                                                                          Visibility="{Binding ShowInlineActions, Converter={StaticResource BoolToVis}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding RollLabel}" Command="{Binding RollCommand}"
                                                                                Padding="10,3" Margin="0,2,8,0" VerticalAlignment="Center" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- A link is only ever followed by the user, and never rolls the destination. -->
                                                            <Button Content="{Binding FollowLabel}" Command="{Binding FollowCommand}"
                                                                    HorizontalAlignment="Left" Padding="14,5" Margin="0,4,0,0"
                                                                    Visibility="{Binding ShowFollow, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding LinkedNote}" Foreground="#777" Margin="0,2,0,0"
                                                                       Visibility="{Binding ShowLinkedNote, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding UnresolvedNote}" Foreground="{StaticResource WarningText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding ShowUnresolved, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="⚠ The linked table no longer exists." Foreground="{StaticResource WarningText}" Margin="0,4,0,0"
                                                                       Visibility="{Binding ShowMissing, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Rolling always applies to the current (last) table in the trail. -->
            <StackPanel x:Name="RollControls" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <!-- How many independent rolls one Roll makes: chosen by the person (1 by default), never read from a table's text.
                     Manual entry is always one typed result and ignores it. -->
                <TextBlock Text="Rolls:" Foreground="#666" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="RollCountBox" ItemsSource="{Binding RollCountOptions}" SelectedItem="{Binding RollCount}" Width="52"
                          VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="{Binding IsRollCountEditable}"
                          AutomationProperties.Name="Number of rolls" ToolTip="How many times Roll rolls this table (each result is kept separately)" />
                <Button x:Name="RollButton" Content="{Binding RollButtonLabel}" FontSize="18" Padding="32,8" Command="{Binding RollCommand}" />
                <!-- A temporary situational modifier for the next Roll only: added after the dice, then reset to 0. Not for d66,
                     manual entry or inline rolls, and locked while a roll is in the air (that roll already took its value). -->
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsModifierAvailable, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Modifier:" Foreground="#666" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="ModifierBox" Width="54" Padding="4" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Situational modifier"
                             ToolTip="Added to the next Roll only (for example +2 or -1), then reset to 0. Not used by a typed roll."
                             IsEnabled="{Binding IsModifierEditable}"
                             Text="{Binding ModifierText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RollCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <!-- Shown only while a visual (dddice) roll is in the air; the table result appears when the dice settle. -->
                <TextBlock x:Name="RollStatusText" Text="{Binding RollStatus}" AutomationProperties.AutomationId="RollStatus"
                           FontSize="16" Foreground="#555" VerticalAlignment="Center" Margin="14,0,0,0" />
                <TextBlock Text="or enter a roll:" Foreground="#666" VerticalAlignment="Center" Margin="24,0,8,0" />
                <TextBox x:Name="ManualBox" Width="70" Padding="4" VerticalContentAlignment="Center"
                         Text="{Binding ManualRollText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ResolveManualCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Resolve" Padding="14,6" Margin="8,0,0,0" Command="{Binding ResolveManualCommand}" />
            </StackPanel>
            <TextBlock x:Name="ModifierErrorText" Text="{Binding ModifierError}" Foreground="{StaticResource ProblemText}" Margin="0,6,0,0"
                       Visibility="{Binding HasModifierError, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource ProblemText}" Margin="0,6,0,0" />
            </StackPanel>

            <WrapPanel Margin="0,24,0,6">
                <TextBlock Text="{Binding Title, StringFormat=Table: {0}}" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="0,0,16,0" />
                <!-- Export…: one result set of this table, as plain text, Sojour rows, Foundry VTT JSON or Owlbear Rodeo Tables+ JSON. Read-only: rolls and results are untouched. -->
                <ComboBox x:Name="CopyResultSetBox" ItemsSource="{Binding CopyResultSetNames}" SelectedIndex="{Binding CopyResultSetIndex}"
                          MinWidth="120" Margin="0,0,6,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Result set to export" ToolTip="Which result set Export… copies or saves"
                          Visibility="{Binding ShowCopyResultSetChoice, Converter={StaticResource BoolToVis}}" />
                <Button x:Name="ExportButton" Content="Export…" Padding="10,2" VerticalAlignment="Center" Click="OnExportClick"
                        ToolTip="Copy this table as plain text, as rows for a Sojour Lookup Table, or as JSON for Foundry VTT's Roll Table Importer or Owlbear Rodeo (Tables+)">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ExportMenu">
                            <MenuItem Header="Copy Table Text" Command="{Binding CopyTableTextCommand}"
                                      ToolTip="Plain text: name, dice, then one range and result per line" />
                            <MenuItem Header="Copy Table Text (Spaces)" Command="{Binding CopyTableTextSpacesCommand}"
                                      ToolTip="The same plain text, with one space instead of a tab between each range and its result" />
                            <MenuItem Header="Copy for Sojour" Command="{Binding CopyForSojourCommand}"
                                      ToolTip="Only the rows, range and result per line, to paste with Ctrl+V into a Sojour Lookup Table" />
                            <Separator />
                            <MenuItem Header="Copy Foundry JSON" Command="{Binding CopyFoundryJsonCommand}"
                                      ToolTip="JSON to paste into Foundry VTT's Roll Table Importer" />
                            <MenuItem Header="Save Foundry JSON…" Command="{Binding SaveFoundryJsonCommand}"
                                      ToolTip="The same JSON, saved as a .json file for Roll Table Importer" />
                            <Separator />
                            <MenuItem Header="Copy Tables+ JSON" Command="{Binding CopyTablesPlusJsonCommand}"
                                      ToolTip="JSON to import into Owlbear Rodeo (Tables+)" />
                            <MenuItem Header="Save Tables+ JSON…" Command="{Binding SaveTablesPlusJsonCommand}"
                                      ToolTip="The same JSON, saved as a .json file to import into Owlbear Rodeo (Tables+)" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock x:Name="CopyMessageText" Text="{Binding CopyMessage}" Foreground="#2E6B3A" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding HasCopyMessage, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
            <TextBlock x:Name="ExportWarningText" Text="{Binding ExportWarning}" Foreground="{StaticResource WarningText}" TextWrapping="Wrap"
                       Margin="0,0,0,6" Visibility="{Binding HasExportWarning, Converter={StaticResource BoolToVis}}" />

            <!-- Result sets that are genuine parallel outputs of one roll (same row count, same range at every row):
                 shown as one aligned multi-column grid instead of separate stacked sections, mirroring the Review
                 screen (see RollStepViewModel.IsAligned). Each column is still its own independent result set
                 underneath — only the presentation is grouped. -->
            <Grid Margin="0,0,0,2" Visibility="{Binding IsAligned, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="AlignedRollHeaders" Grid.Column="1" ItemsSource="{Binding ResultSets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="230" Margin="4,0,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <ItemsControl x:Name="AlignedRollRowsList" ItemsSource="{Binding AlignedRows}"
                          Visibility="{Binding IsAligned, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4,2" CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource MatchBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RangeLabel}" FontFamily="Consolas" Foreground="#555" Width="90" />
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock views:FormattedText.Segments="{Binding Segments}" Width="230" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Single result set, or several independent sets that are not parallel outputs (e.g. Ambient/Noise):
                 shown one at a time, stacked, as before. -->
            <ItemsControl x:Name="ResultSetsList" ItemsSource="{Binding ResultSets}"
                          Visibility="{Binding IsNotAligned, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,2"
                                       Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,2" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource MatchBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RangeLabel}" FontFamily="Consolas" Foreground="#555" />
                                                <TextBlock Grid.Column="1" views:FormattedText.Segments="{Binding Segments}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
