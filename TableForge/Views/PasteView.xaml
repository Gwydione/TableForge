<UserControl x:Class="TableForge.Views.PasteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Paste Table" FontSize="20" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" Foreground="#555" TextWrapping="Wrap">
            <Run Text="Paste the copied table text below, then choose Interpret (or press Ctrl+Enter). It will be added to" />
            <Run Text="{Binding CollectionName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
        </TextBlock>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Interpret" Padding="18,6" Command="{Binding InterpretCommand}" />
            <Button Content="Cancel" Padding="18,6" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
        </StackPanel>

        <!-- Raw-text cleanup before parsing: fixes clipboard damage the parser might otherwise lose or misclassify. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Join Lines" Padding="8,3" Margin="0,0,6,0" Click="OnJoinLinesClick"
                    ToolTip="Ctrl+J — join the selected lines into one line, or the current line into the line above it" />
            <Button Content="Normalize Text" Padding="8,3" Click="OnNormalizeTextClick"
                    ToolTip="Fix non-breaking spaces, repeated whitespace and fi/fl ligatures, one line at a time" />
            <Button Content="Dehyphenate" Padding="8,3" Margin="6,0,0,0" Click="OnDehyphenateClick"
                    ToolTip="Remove PDF line-wrap hyphens (&quot;magnifi-&#10;cent&quot; becomes &quot;magnificent&quot;)" />
            <Button x:Name="FindNextDamagedButton" Content="Find Next Damaged Character" Padding="8,3" Margin="6,0,0,0"
                    Click="OnFindNextDamagedClick" Visibility="{Binding HasDamagedCharacters, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding CleanupMessage}" Foreground="#555" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" BorderBrush="#E0B400" BorderThickness="1" CornerRadius="3" Background="#FFF4D6"
                Visibility="{Binding HasDamagedCharacters, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding DamagedCharacterWarning}" Foreground="#7A5200" TextWrapping="Wrap" />
        </Border>

        <TextBox x:Name="PasteSourceBox" Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="14"
                 ToolTip="Ctrl+J — join the selected lines into one line, or the current line into the line above it"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBox.InputBindings>
                <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding InterpretCommand}" />
            </TextBox.InputBindings>
        </TextBox>
    </DockPanel>
</UserControl>
